{
  "name": "kuni",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Kuni — local AI chatbot on KunoEngine (WebLLM + WASM)",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:nested": "tsc && KUNI_BASE=${KUNI_BASE:-/kuni/} vite build",
    "preview": "vite preview",
    "desktop:dev": "npm --prefix desktop run dev",
    "desktop:build": "npm --prefix desktop run build",
    "android:sync": "npx cap sync android",
    "android:open": "npx cap open android"
  },
  "dependencies": {
    "@mlc-ai/web-llm": "^0.2.86",
    "@wllama/wllama": "^3.8.1",
    "marked": "^18.1.1"
  },
  "devDependencies": {
    "@capacitor/android": "^7.6.9",
    "@capacitor/cli": "^7.6.9",
    "@capacitor/core": "^7.6.9",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  },
  "overrides": {
    "@xmldom/xmldom": "0.9.12",
    "brace-expansion": "5.0.12"
  }
}
